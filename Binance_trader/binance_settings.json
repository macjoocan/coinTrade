{
  "_comment": "Binance Futures Bot 설정 파일",
  "_version": "2.0.0",
  "mode": "live",
  "api": {
    "_comment": "API 키는 .env 파일에서 관리 (이 파일에 직접 입력하지 마세요)",
    "key": "",
    "secret": ""
  },
  "simulation": {
    "initial_balance": 10000
  },
  "trading": {
    "symbols": [
      "BTC/USDT",
      "ETH/USDT",
      "SOL/USDT",
      "DOGE/USDT"
    ]
  },
  "risk": {
    "max_position_size": 0.25,
    "leverage": 3,
    "leverage_per_symbol": {
      "_comment": "코인별 레버리지 (미설정 코인은 기본 leverage 사용)",
      "BTC": 5,
      "ETH": 3,
      "SOL": 3,
      "DOGE": 3
    },
    "stop_loss": 0.02,
    "take_profit": 0.04,
    "daily_loss_limit": 0.05,
    "max_positions": 3
  },
  "trailing_stop": {
    "enabled": true,
    "activation": 0.02,
    "distance": 0.01
  },
  "strategy": {
    "threshold": 3,
    "base_timeframe": "1h",
    "trend_timeframe": "4h",
    "entry_score_threshold": 0.2,
    "allow_sideways_entry": true,
    "scan_interval": 120
  },
  "ml": {
    "enabled": true,
    "min_probability": 0.6,
    "weight": 0.3
  },
  "partial_exit": {
    "_comment": "분할 익절 설정 (adaptive: ATR 기반 자동 조절)",
    "enabled": true,
    "trigger_profit": 0.015,
    "exit_ratio": 0.5,
    "adaptive": true
  },
  "reverse_exit": {
    "_comment": "추세 반전 시 강제 청산 설정",
    "enabled": true,
    "score_threshold": 0.3,
    "min_hold_minutes": 30
  }
}